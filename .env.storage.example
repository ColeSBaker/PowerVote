# Copy this file to .env.storage and replace all CHANGE_ME values before running docker compose.

# Database
POSTGRES_USER=powervote
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=powervote
DATABASE_URL=postgresql://powervote:CHANGE_ME_IN_PRODUCTION@localhost:5432/powervote

# MinIO/S3
MINIO_ROOT_USER=CHANGE_ME_IN_PRODUCTION
MINIO_ROOT_PASSWORD=CHANGE_ME_IN_PRODUCTION
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=powervote-snapshots
S3_ACCESS_KEY_ID=CHANGE_ME_IN_PRODUCTION
S3_SECRET_ACCESS_KEY=CHANGE_ME_IN_PRODUCTION
